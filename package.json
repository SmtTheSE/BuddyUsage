{
  "name": "buddy-usage",
  "productName": "BuddyUsage",
  "version": "0.4.1",
  "description": "An edge-docked island for macOS that shows live plan usage for Claude Code, Codex CLI, Gemini CLI and other AI coding assistants.",
  "main": "./out/main/index.js",
  "author": "chris@dvrk.vn",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://smtthese.github.io/BuddyUsage/",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmtTheSE/BuddyUsage.git"
  },
  "bin": {
    "buddyusage": "./bin/buddyusage.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mac": "npm run build && electron-builder --mac",
    "release": "npm run build && electron-builder --mac --publish always",
    "cli": "node ./bin/buddyusage.mjs",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "electron-store": "^10.0.0",
    "framer-motion": "^11.11.17",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
